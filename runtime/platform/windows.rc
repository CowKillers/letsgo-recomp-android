// The .exe's icon (Makefile: windres -I docs/icon). ID 1: Explorer and the taskbar use the first icon resource.
1 ICON "icon.ico"
// The application manifest (RT_MANIFEST 24, ID 1): UTF-8 as the process code page. Paths are UTF-8 in the runtime, but
// fopen / stat / opendir read them in the system code page, so a folder named with accents or other non-ASCII characters was not found
1 24 "windows.manifest"

// Name shown by Task Manager and the file's properties (the window title is RT_APP_NAME, runtime/paths.h)
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Let's Go Recomp"
      VALUE "ProductName", "Let's Go Recomp"
      VALUE "OriginalFilename", "lasrecomp.exe"
      VALUE "FileVersion", "0.1"
      VALUE "ProductVersion", "0.1"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
